FROM python:3.11-slim

WORKDIR /app

# Install system dependencies if required
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy source code layers
COPY layer1_data/ layer1_data/
COPY layer2_tools/ layer2_tools/
COPY layer3_agents/ layer3_agents/
COPY layer4_orchestration/ layer4_orchestration/
COPY layer6_api/ layer6_api/

EXPOSE 8000

ENV PORT=8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:' + __import__('os').environ.get('PORT','8000') + '/health')" || exit 1

CMD ["sh", "-c", "uvicorn layer6_api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
