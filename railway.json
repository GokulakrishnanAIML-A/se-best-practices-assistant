{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "build": {
    "dockerfilePath": "layer8_deployment/Dockerfile.api"
  },
  "deploy": {
    "startCommand": "uvicorn layer6_api.main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
